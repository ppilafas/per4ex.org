{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "ANALYZE=true next build",
    "optimize-images": "imagemin 'public/**/*.{png,jpg,jpeg}' --out-dir=public --plugin=mozjpeg --plugin=pngquant --plugin=svgo",
