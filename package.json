    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "gray-matter": "^4.0.3",
    "next": "16.1.0",
    "next-intl": "^4.7.0",
    "openai": "^6.34.0",
    "react": "19.2.3",
